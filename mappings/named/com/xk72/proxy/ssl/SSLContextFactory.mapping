		ARG 3 notAfter
		ARG 4 upstreamCertificate
		ARG 5 hostName
		ARG 6 keyAlgorithm
		ARG 7 keyParameters
	METHOD method_3786 getOrCreateSslContext (Ljavax/security/auth/x500/X500Principal;Ljava/math/BigInteger;Ljava/util/Date;Ljava/util/Date;Ljava/security/cert/X509Certificate;Ljava/lang/String;Ljava/lang/String;Ljava/lang/Object;)Ljavax/net/ssl/SSLContext;
		COMMENT [charles4] the whole cache-then-generate path. A saved key store is rejected if its
