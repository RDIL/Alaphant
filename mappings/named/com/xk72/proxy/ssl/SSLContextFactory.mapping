	METHOD method_3789 copyExtension (Lorg/bouncycastle/asn1/ASN1ObjectIdentifier;Ljava/security/cert/X509Certificate;Lorg/bouncycastle/cert/jcajce/JcaX509v3CertificateBuilder;ZLjava/lang/String;)V
