	METHOD method_1263 saveCustomPresets ()V
		COMMENT Copies the in-progress custom preset list into the live ThrottlingConfiguration and
		COMMENT saves, so an added or removed preset survives independently of OK/Cancel on the dialog.
	METHOD method_1264 formatDecimal (D)Ljava/lang/String;
		COMMENT Renders a double without a redundant ".0", so a whole-number bandwidth shows as "512"
		COMMENT rather than "512.0". Both call sites are the two bandwidth fields.
		ARG 0 value
	METHOD method_1265 blocksizeForValue (I)Lcom/charlesproxy/gui/settings/ThrottleSettingsPanel$Blocksize;
		COMMENT The reverse of Blocksize.getValue(): finds the constant holding the stored
		COMMENT reliabilityBlocksize so the combo can be set from a saved configuration.
		ARG 0 value
	METHOD method_1266 addPreset (Lcom/charlesproxy/config/class_77;)V
		COMMENT Forwards to the form's addPreset.
		ARG 1 preset
	METHOD method_1267 findMatchingPreset (Lcom/charlesproxy/config/class_108;)Lcom/charlesproxy/config/class_77;
		COMMENT Scans the built-in PRESETS and then the custom ones for the first whose settings equal
		COMMENT the argument, returning null when the values match none. This is what lets the preset
		COMMENT combo follow hand-edited fields.
		ARG 1 settings
	METHOD method_1268 removePreset (Ljava/lang/Object;)V
		COMMENT Forwards to the form's removePreset, keeping its Object parameter.
		ARG 1 preset
	METHOD method_1269 isPresetNameTaken (Ljava/lang/String;)Z
		COMMENT True when either a built-in or a custom preset already uses the name; the Add Preset
		COMMENT flow checks it before accepting one.
		ARG 1 name
	CLASS Blocksize Blocksize
