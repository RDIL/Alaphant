	CLASS GenericChallenge GenericChallenge
		METHOD getParameters getParameters ()Ljava/util/List;
		METHOD setParseException setParseException (Ljava/lang/Exception;)V
	CLASS NameValue NameValue
	CLASS UnsupportedAuthorization UnsupportedAuthorization
