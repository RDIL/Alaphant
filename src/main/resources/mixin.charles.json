{
  "required": true,
  "verbose": true,
  "minVersion": "0.8.7",
  "package": "alaphant.mixin",
  "compatibilityLevel": "JAVA_17",
  "target": "@env(DEFAULT)",
  "mixins": [
    "devSupport.MacOSImplMixin",
    "jwt.MixinAuthorizationUtils$GenericAuthorization",
    "remappedReflection.MacOSManagerMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
